# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Resend (email notifications)
RESEND_API_KEY=re_your_key_here

# Email where form submissions are sent (defaults to hello@educoach.in)
NOTIFICATION_EMAIL=hello@educoach.in

# Sender address (defaults to onboarding@resend.dev until you verify your domain in Resend)
# EMAIL_FROM=EduCoach <noreply@educoach.in>
